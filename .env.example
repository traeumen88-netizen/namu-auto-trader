# =======================================================
# 나무증권(NH투자증권) 나무 플러그(NH PLUG) 환경 설정 템플릿
# =======================================================

# 1. Open API 인증 키
NHPLUG_APP_KEY=YOUR_APP_KEY_HERE
NHPLUG_APP_SECRET=YOUR_APP_SECRET_HERE

# 2. 투자 환경 설정 ('mock': 모의투자, 'live': 실전투자)
TRADING_MODE=mock

# 3. 계좌번호 설정
ACCOUNT_MOCK=YOUR_MOCK_ACCOUNT_NO
ACCOUNT_LIVE=YOUR_LIVE_ACCOUNT_NO

# 4. 리스크 관리 파라미터
STOP_LOSS_RATE=-0.02
TAKE_PROFIT_RATE=0.04
MAX_INVEST_PER_STOCK=1000000

# 5. 드라이런 모드
DRY_RUN=false
