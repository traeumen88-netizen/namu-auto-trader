# 보안 민감 설정 파일 (절대 Git에 커밋하지 않음)
.env
*.env
config/kakao_token.json
config/telegram_config.json

# 파이썬 캐시
__pycache__/
*.py[cod]
*$py.class
*.pyc

# 로그 및 임시 파일
*.log
*.tmp
*.db
*.sqlite
*.sqlite3
*.key
*.pem
*.secret
.token-*.json
~/.nhplug/

# 데이터 디렉터리: live_telemetry를 제외한 모든 DB, 로그, 락 파일 차단
data/*
!data/live_telemetry/
data/live_telemetry/.git_sync.lock
data/live_telemetry/**/*.tmp
data/live_telemetry/*.tmp

models/
scratch/
scratch_*.txt
why_no_buy_dump.txt


# 가상환경
.venv/
env/
venv/
ENV/
